# Auto detect text files and perform LF normalization
* text=auto

# ---- Source code ----
*.cpp text diff=cpp
*.cxx text diff=cpp
*.cc  text diff=cpp
*.c   text diff=cpp
*.hpp text diff=cpp
*.hxx text diff=cpp
*.hh  text diff=cpp
*.h   text diff=cpp

# ---- Build system ----
*.cmake       text
CMakeLists.txt text

# ---- Documentation ----
*.md   text diff=markdown
*.txt  text
*.rst  text

# ---- Data / config ----
*.yml  text
*.yaml text
*.json text
*.xml  text
*.toml text
*.cfg  text
*.conf text
*.ini  text

# ---- Shell scripts ----
*.sh   text eol=lf
*.bash text eol=lf

# ---- Binary files ----
*.pcap  binary
*.pcapng binary
*.a     binary
*.o     binary
*.so    binary
*.dylib binary
*.lib   binary
*.dll   binary
*.exe   binary
*.out   binary

# ---- Images ----
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text

# ---- GitHub linguist overrides ----
*.cpp linguist-language=C++
*.hpp linguist-language=C++
*.h   linguist-language=C++
